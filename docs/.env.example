# Database Configuration
# Use one of the following database options:

# Option 1: Turso Cloud Database (Recommended for production)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Option 2: PostgreSQL (Alternative for production)
# POSTGRES_URL=postgres://username:password@host:port/database
# DATABASE_URL=postgres://username:password@host:port/database

# Option 3: Local SQLite (Default for development)
# No configuration needed - uses local file: literary_escape.db

# Application Configuration
NODE_ENV=development
PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration (Required for Password Reset)
# For Gmail:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# For other email providers, adjust HOST and PORT accordingly
# Common providers:
# - Gmail: smtp.gmail.com:587
# - Outlook: smtp-mail.outlook.com:587
# - Yahoo: smtp.mail.yahoo.com:587
# - SendGrid: smtp.sendgrid.net:587

# Base URL (for password reset links)
BASE_URL=http://localhost:3000
# In production: BASE_URL=https://your-domain.vercel.app

# Note: For Gmail, you need to:
# 1. Enable 2-factor authentication
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use the app password as EMAIL_PASSWORD (not your regular Gmail password)
